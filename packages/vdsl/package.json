{
  "name": "@prnt/dagr-vdsl",
  "version": "0.1.2",
  "description": "Toolkit for building a node-graph language on Dagr: the node spec adapter and its registry.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@prnt/dagr-graph": "workspace:^"
  },
  "devDependencies": {
    "@prnt/dagr-graph": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prnt-design/dagr.git",
    "directory": "packages/vdsl"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  }
}
