{
  "name": "@dagr/react",
  "version": "0.1.0",
  "description": "React bindings for Dagr: the DagrCanvas component and hooks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prnt-design/dagr.git",
    "directory": "packages/react"
  },
  "peerDependencies": {
    "@dagr/graph": "workspace:^",
    "@dagr/render": "workspace:^",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@dagr/graph": "workspace:^",
    "@dagr/render": "workspace:^",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@dagr/layout": "workspace:^"
  }
}
