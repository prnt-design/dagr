{
  "name": "@dagr/graph",
  "version": "0.1.0",
  "description": "Typed directed graph model for Dagr: stable node identity, zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/prnt-design/dagr",
    "directory": "packages/graph"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run --outputJson bench-report.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@dagr/bench": "workspace:*",
    "fast-check": "^4.9.0"
  }
}
