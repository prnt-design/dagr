{
  "name": "@dagr/layout",
  "version": "0.1.0",
  "description": "Headless Sugiyama layout pipeline for Dagr, the dagre successor: incremental and animation first.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@dagr/graph": "workspace:^"
  },
  "devDependencies": {
    "@dagr/bench": "workspace:*",
    "@dagr/graph": "workspace:^",
    "@dagrejs/dagre": "3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prnt-design/dagr",
    "directory": "packages/layout"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run --outputJson bench-report.json",
    "build": "tsc -p tsconfig.build.json"
  }
}
