{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    // The Docusaurus base has no `DOM.Iterable`. @prnt/dagr-explorer's source,
    // which typecheck reads through `paths` below, iterates a `NodeList`, and
    // its own tsconfig declares the lib for that.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // The site imports the engine it advertises: the landing page's benchmark
    // runs @prnt/dagr-layout, and /demos/campaign mounts the renderer through
    // @dagr/campaign-stage. Every one of these packages publishes from `dist`,
    // which does not exist in a fresh clone or in CI, where typecheck runs
    // before build, so typecheck reads them from source the way every other
    // workspace package does. The bundler still resolves the built `dist`
    // through node_modules, which is why `render.yaml` builds them ahead of
    // this site.
    // ADDING ONE IS TWO EDITS, the docs-site form of the rule in
    // apps/demo/README.md: an entry here, so typecheck reads source, and a
    // dependency in package.json, so webpack can resolve the package at all.
    // The list is longer than what this site imports by name, because
    // typecheck follows @dagr/campaign-stage's own source into @dagr/campaign,
    // @prnt/dagr-graph and @prnt/dagr-render, and @dagr/living-stage's into @prnt/dagr-react.
    // `@prnt/dagr-render/core` is its own entry because @prnt/dagr-explorer's
    // source imports that subpath, which the `@prnt/dagr-render` entry does
    // not cover.
    // `@site/*` is restated because `paths` replaces the inherited map rather
    // than merging with it, and the Docusaurus base config is where it comes
    // from.
    "paths": {
      "@site/*": ["./*"],
      "@dagr/campaign": ["../packages/campaign/src/index.ts"],
      "@dagr/campaign-stage": ["../packages/campaign-stage/src/index.ts"],
      "@prnt/dagr-vdsl": ["../packages/vdsl/src/index.ts"],
      "@prnt/dagr-graph": ["../packages/graph/src/index.ts"],
      "@prnt/dagr-layout": ["../packages/layout/src/index.ts"],
      "@dagr/living-stage": ["../packages/living-stage/src/index.ts"],
      "@prnt/dagr-react": ["../packages/react/src/index.ts"],
      "@prnt/dagr-render": ["../packages/render/src/index.ts"],
      "@prnt/dagr-render/core": ["../packages/render/src/core.ts"],
      "@prnt/dagr-explorer": ["../packages/explorer/src/index.ts"]
    }
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src"],
  "exclude": [".docusaurus", "build", "node_modules"]
}
